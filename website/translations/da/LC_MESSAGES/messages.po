msgstr "Foderautomaten kørte i"

#: website/templates/calibration.html:56
msgid "seconds."
msgstr "sekunder."

#: website/templates/calibration.html:57
msgid "Weigh the feed it dispensed and enter the amount below."
msgstr "Vej det foder, den udleverede, og indtast mængden nedenfor."

